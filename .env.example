# Copy to .env. Real values stay local.
OPENAI_API_KEY=
ROTATOR_MODEL=gpt-6-luna

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legacy-password-rotation
# Set only if your LangSmith account is in the EU region.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

DASHBOARD_URL=http://127.0.0.1:8000
ROTATOR_URL=http://127.0.0.1:8100
BAO_ADDR=http://127.0.0.1:8200
# BAO_TOKEN is read from .bao/state.json when unset.

# Days added to the real clock, to simulate time passing.
CLOCK_OFFSET_DAYS=0
# Pause for human approval before every password change.
SUPERVISED=false

# WSL without libgbm: point Chromium at locally unpacked libraries (see README).
# LD_LIBRARY_PATH=/path/to/repo/.tools/libroot/usr/lib/x86_64-linux-gnu
